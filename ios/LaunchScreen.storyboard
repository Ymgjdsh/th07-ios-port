<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="20086" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" initialViewController="launch-controller">
    <device id="ipad12_9" orientation="landscape" appearance="dark"/>
    <dependencies><deployment identifier="iOS"/><plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="20058"/></dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="1024" height="768"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" text="Touhou 07" textAlignment="center" textColor="white" translatesAutoresizingMaskIntoConstraints="NO" id="title"><fontDescription key="fontDescription" type="system" weight="semibold" pointSize="34"/></label>
                            <label opaque="NO" userInteractionEnabled="NO" text="Perfect Cherry Blossom - iOS 14" textAlignment="center" textColor="white" alpha="0.72" translatesAutoresizingMaskIntoConstraints="NO" id="subtitle"><fontDescription key="fontDescription" type="system" pointSize="17"/></label>
                            <activityIndicatorView opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="750" verticalHuggingPriority="750" style="large" color="white" animating="YES" translatesAutoresizingMaskIntoConstraints="NO" id="spinner"/>
                        </subviews>
                        <color key="backgroundColor" red="0.035" green="0.047" blue="0.075" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="title" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="title-x"/>
                            <constraint firstItem="title" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" constant="-36" id="title-y"/>
                            <constraint firstItem="subtitle" firstAttribute="top" secondItem="title" secondAttribute="bottom" constant="10" id="subtitle-y"/>
                            <constraint firstItem="subtitle" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="subtitle-x"/>
                            <constraint firstItem="spinner" firstAttribute="top" secondItem="subtitle" secondAttribute="bottom" constant="28" id="spinner-y"/>
                            <constraint firstItem="spinner" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="spinner-x"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
</document>
